# Copy is unnecessary: `make up` writes .env with random secrets when it is missing.
# Nothing in this file is a live credential. LLM_MODE=rules needs no key.

SWITCH_VERSION=0.31.0
SWITCH_REGISTRY=ghcr.io
SWITCH_IMAGE_NAMESPACE=sandbox-quantum
API_HOST_PORT=8000
GATEWAY_HOST_PORT=3000
MATTERMOST_HOST_PORT=8065
POSTGRES_HOST_PORT=5432
SWITCH_BIND_ADDR=127.0.0.1

DB_USER=switch_app
DB_PASSWORD=
DB_OWNER_USER=postgres
DB_OWNER_PASSWORD=
DB_NAME=switch
AGENT_REGISTRATION_TOKEN=
SECRET_KEYS=
GATEWAY_ADMIN_EMAIL=admin@switch.local
GATEWAY_ADMIN_PASSWORD=
MATTERMOST_ADMIN_USER=admin
MATTERMOST_ADMIN_PASSWORD=
MATTERMOST_TEAM_NAME=switch
MATTERMOST_USER=user
MATTERMOST_USER_PASSWORD=
MAYA_PASSWORD=
SAM_PASSWORD=

# rules: regex and templates, no network. live: OpenAI-compatible chat completions.
# Amounts and dates are still taken from code in live mode.
LLM_MODE=rules
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini

ROOM_NAME=club-finance
ROOM_USERS=user,maya,sam
TREASURER_USERNAMES=user
# seed: write the packaged policy only when the room document is missing.
# always: overwrite the room document from policy/club-policy.yaml on boot.
DESK_SYNC_POLICY=seed
TELEMETRY_ENABLED=false
